---
interface Item {
  label: string;
  content: string;
  icon?: string;
}

interface Props {
  id?: string;
  large?: boolean;
  items?: Item[];
}

const {
  id = 'docs-tabs',
  large = false,
  items = [
    { label: 'Overview', content: 'The first panel.' },
    { label: 'Usage', content: 'The second panel.' },
    { label: 'API', content: 'The third panel.' },
  ],
} = Astro.props;
---

<k-tabs
  id={id}
  class="k-tabs"
  size={large ? 'lg' : undefined}
  panels={JSON.stringify(items)}></k-tabs>

<script>
  import 'k-web-ui/js';
</script>
