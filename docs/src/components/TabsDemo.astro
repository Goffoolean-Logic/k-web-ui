---
interface Item {
  label: string;
  icon?: string;
}

interface Props {
  id?: string;
  large?: boolean;
  label?: string;
  items?: Item[];
}

const {
  id = 'docs-tabs',
  large = false,
  label = 'Sections',
  items = [{ label: 'Progress' }, { label: 'Notes' }, { label: 'Invite' }],
} = Astro.props;
---

<k-tabs
  id={id}
  class:list={['k-tabs', large && 'k-tabs--lg']}
  aria-label={label}></k-tabs>

<div id={`${id}-0`}>
  <k-gauge id={`${id}-gauge`} class="k-gauge"></k-gauge>
</div>

<div id={`${id}-1`}>
  <p>The other two panels are components. This one is a paragraph.</p>
</div>

<div id={`${id}-2`}>
  <div class="k-field">
    <label class="k-label" for={`${id}-email`}>Email</label>
    <input
      class="k-input"
      id={`${id}-email`}
      type="text"
      placeholder="maya@example.com"
    />
  </div>
  <button type="button" class="k-btn k-btn--primary">Send</button>
</div>

<script>
  import 'k-web-ui/js';
</script>

<script is:inline define:vars={{ id, items }}>
  customElements.whenDefined('k-tabs').then(() => {
    document.getElementById(id).options = items;
    document.getElementById(`${id}-gauge`).options = {
      value: 64,
      max: 100,
      label: 'Upload',
      format: '%',
    };
  });
</script>
