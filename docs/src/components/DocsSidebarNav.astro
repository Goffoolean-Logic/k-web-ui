---
interface SidebarLink {
  type: 'link';
  label: string;
  href: string;
  isCurrent: boolean;
  badge?: { text: string; variant?: string };
  attrs?: Record<string, unknown>;
}

interface SidebarGroup {
  type: 'group';
  label: string;
  entries: SidebarEntry[];
  collapsed?: boolean;
  badge?: { text: string; variant?: string };
}

type SidebarEntry = SidebarLink | SidebarGroup;

interface Props {
  entries: SidebarEntry[];
  nested?: boolean;
}

const STORAGE_KEY = 'k_docs_sidebar_groups';

const { entries, nested = false } = Astro.props;

function readStored(): Record<string, boolean> {
  const raw = Astro.cookies.get(STORAGE_KEY)?.value;
  if (!raw) return {};
  try {
    return JSON.parse(decodeURIComponent(raw)) as Record<string, boolean>;
  } catch {
    try {
      return JSON.parse(raw) as Record<string, boolean>;
    } catch {
      return {};
    }
  }
}

const stored = nested ? {} : readStored();

function containsCurrent(group: SidebarGroup): boolean {
  const walk = (items: SidebarEntry[]): boolean =>
    items.some((item) =>
      item.type === 'link' ? item.isCurrent : walk(item.entries),
    );
  return walk(group.entries);
}

function groupOpen(group: SidebarGroup): boolean {
  if (containsCurrent(group)) return true;
  if (Object.hasOwn(stored, group.label)) return stored[group.label]!;
  return false;
}
---

<ul
  class:list={[
    'k-sidebar__list',
    nested ? 'k-sidebar__list--nested' : null,
  ]}
>
  {
    entries.map((entry) =>
      entry.type === 'link' ? (
        <li>
          <a
            href={entry.href}
            class="k-sidebar__link"
            aria-current={entry.isCurrent ? 'page' : undefined}
            {...(entry.attrs ?? {})}
          >
            {entry.label}
          </a>
        </li>
      ) : (
        <li>
          <details
            class="k-sidebar__group"
            data-sidebar-group={entry.label}
            open={groupOpen(entry)}
          >
            <summary class="k-sidebar__heading">
              <span>{entry.label}</span>
              <span class="k-icon k-icon--chevron-down k-icon--xs" aria-hidden="true" />
            </summary>
            <Astro.self entries={entry.entries} nested />
          </details>
        </li>
      ),
    )
  }
</ul>

{
  !nested && (
    <script is:inline define:vars={{ STORAGE_KEY }}>
      (() => {
        const nav = document.currentScript?.previousElementSibling;
        let state = {};
        try {
          state = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '{}');
        } catch {}
        const roots = nav?.querySelectorAll
          ? nav.querySelectorAll('details.k-sidebar__group[data-sidebar-group]')
          : document.querySelectorAll(
              'details.k-sidebar__group[data-sidebar-group]',
            );
        for (const el of roots) {
          if (!(el instanceof HTMLDetailsElement)) continue;
          const id = el.getAttribute('data-sidebar-group');
          if (!id) continue;
          // Only open — never close — so SSR/cookie state cannot flash shut.
          if (el.querySelector('a[aria-current="page"]')) {
            el.open = true;
          } else if (
            !el.open &&
            Object.prototype.hasOwnProperty.call(state, id) &&
            state[id]
          ) {
            el.open = true;
          }
        }
      })();
    </script>
  )
}

{
  !nested && (
    <script>
      const STORAGE_KEY = 'k_docs_sidebar_groups';

      function load(): Record<string, boolean> {
        try {
          return JSON.parse(
            sessionStorage.getItem(STORAGE_KEY) || '{}',
          ) as Record<string, boolean>;
        } catch {
          return {};
        }
      }

      function save(state: Record<string, boolean>): void {
        const raw = JSON.stringify(state);
        sessionStorage.setItem(STORAGE_KEY, raw);
        document.cookie = `${STORAGE_KEY}=${encodeURIComponent(raw)}; path=/; SameSite=Lax`;
      }

      function groups(): NodeListOf<Element> {
        return document.querySelectorAll(
          'details.k-sidebar__group[data-sidebar-group]',
        );
      }

      /** Persist groups that opened because they hold the current page (e.g. hero → View components). */
      function persistCurrentOpens(): void {
        const state = load();
        let changed = false;
        for (const el of groups()) {
          if (!(el instanceof HTMLDetailsElement)) continue;
          const id = el.getAttribute('data-sidebar-group');
          if (!id || !el.open) continue;
          if (!el.querySelector('a[aria-current="page"]')) continue;
          if (state[id] === true) continue;
          state[id] = true;
          changed = true;
        }
        if (changed) save(state);
      }

      function onToggle(event: Event): void {
        const el = event.target;
        if (!(el instanceof HTMLDetailsElement)) return;
        if (!el.matches('details.k-sidebar__group[data-sidebar-group]')) return;
        const id = el.getAttribute('data-sidebar-group');
        if (!id) return;
        const state = load();
        state[id] = el.open;
        save(state);
      }

      persistCurrentOpens();
      document.addEventListener('astro:page-load', persistCurrentOpens);
      document.addEventListener('toggle', onToggle, true);
    </script>
  )
}
