---
interface Props {
  id?: string;
  trigger?: string;
  end?: boolean;
  select?: boolean;
}

const {
  id = 'docs-dropdown',
  trigger = 'Sort',
  end = false,
  select = true,
} = Astro.props;
---

<k-dropdown
  id={id}
  class:list={['k-dropdown', end && 'k-dropdown--end']}></k-dropdown>

<script>
  import 'k-web-ui/js';
</script>

<script is:inline define:vars={{ id, trigger, select }}>
  customElements.whenDefined('k-dropdown').then(() => {
    document.getElementById(id).options = {
      trigger,
      items: [{ label: 'Name' }, { label: 'Date' }, { label: 'Size' }],
      select,
    };
  });
</script>
