---
interface Props {
  id?: string;
  label?: string;
  end?: boolean;
}

const {
  id = 'docs-dropdown',
  label = 'Sort',
  end = false,
} = Astro.props;

const options = JSON.stringify([
  { label: 'Name' },
  { label: 'Date' },
  { label: 'Size' },
]);
---

<k-dropdown
  id={id}
  class:list={['k-dropdown', end && 'k-dropdown--end']}
  label={label}
  options={options}></k-dropdown>

<script>
  import 'k-web-ui/js';
</script>
