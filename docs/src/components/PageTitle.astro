---
const { entry } = Astro.locals.starlightRoute;
const { kind } = entry.data;

const badge =
  kind === 'js'
    ? { label: 'JS', class: 'doc-title__badge--js' }
    : { label: 'CSS', class: 'k-badge--soft k-badge--info' };
---

<div class="doc-title">
  <div class="doc-title__heading">
    <h1 id="_top" data-page-title>{entry.data.title}</h1>
    {
      kind && (
        <span class={`k-badge k-badge--sm ${badge.class}`}>{badge.label}</span>
      )
    }
  </div>
  <button type="button" class="k-btn k-btn--secondary k-btn--sm" data-copy-md>
    Copy markdown
  </button>
</div>

<script>
  document.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('[data-copy-md]');
    if (!button) return;

    const path = window.location.pathname.replace(/\/$/, '');
    const label = button.textContent;

    try {
      const response = await fetch(`${path}.md`);
      if (!response.ok) throw new Error('missing markdown');
      await navigator.clipboard.writeText(await response.text());
      button.textContent = 'Copied';
    } catch {
      button.textContent = 'Could not copy';
    }

    window.setTimeout(() => {
      button.textContent = label;
    }, 1600);
  });
</script>

<style>
  @layer starlight.core {
    .doc-title {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem 1rem;
      margin-top: 1rem;
    }

    .doc-title :global([data-copy-md]) {
      flex-shrink: 0;
    }

    .doc-title__heading {
      display: flex;
      flex: 1 1 12rem;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.625rem;
    }

    h1 {
      margin: 0;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }

    @media (max-width: 40rem) {
      .doc-title {
        flex-direction: column;
        align-items: flex-start;
      }

      .doc-title__heading {
        flex-basis: auto;
        width: 100%;
      }
    }
  }

  /*
   * Unlayered on purpose. The kit's badge rules live in @layer components,
   * and anything layered loses to them no matter how specific it is.
   * Black border because yellow alone is faint against the light canvas.
   */
  span.k-badge.doc-title__badge--js {
    border-color: var(--k-palette-black);
    background-color: var(--k-palette-yellow-300);
    color: var(--k-palette-black);
  }
</style>
