---
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';
import logo from '../assets/logo.png';
import { HERO_TITLE_SIZE_REM } from '../lib/heroIntro';
import ThemeSelect from './ThemeSelect.astro';

const { data } = Astro.locals.starlightRoute.entry;
const composed = Astro.slots.has('tagline') || Astro.slots.has('actions');
---

{composed && <div
  class="hero"
  data-hero
  data-hero-state="playing"
  style={`--hero-title-size: ${HERO_TITLE_SIZE_REM}`}
>
  <div class="hero-stage">
    <div class="hero-panel sl-flex">
      <div class="sl-flex stack">
        <div class="sl-flex copy">
          <div class="hero-title">
            <h1 id="_top" data-page-title>
              <span class="k-visually-hidden">K-Web-UI</span>
              <span class="hero-intro k-wordmark" data-hero-intro aria-hidden="true">
                <span class="hero-intro__logo-slot">
                  <img
                    class="hero-intro__logo"
                    data-hero-logo
                    src={logo.src}
                    alt=""
                  />
                </span>
                <span class="hero-intro__rest" data-hero-rest translate="no">-Web-UI</span>
              </span>
            </h1>
          </div>
          {data.draft && <DraftContentNotice />}
          {
            Astro.slots.has('tagline') && (
              <div class="tagline">
                <slot name="tagline" />
              </div>
            )
          }
        </div>
        {
          Astro.slots.has('actions') && (
            <div class="actions sl-flex flex w-max max-w-full shrink-0 flex-col flex-nowrap items-stretch justify-center gap-4 tablet:w-auto tablet:flex-row tablet:flex-wrap tablet:items-center tablet:gap-x-5">
              <slot name="actions" />
              <ThemeSelect class="w-full tablet:w-auto max-tablet:[&_k-dropdown]:w-full max-tablet:[&_.k-dropdown\_\_trigger]:box-border max-tablet:[&_.k-dropdown\_\_trigger]:min-h-10 max-tablet:[&_.k-dropdown\_\_trigger]:w-full max-tablet:[&_.k-dropdown\_\_trigger]:whitespace-nowrap tablet:[&_.k-dropdown\_\_trigger]:min-w-[9.5rem]" />
            </div>
          )
        }
      </div>
    </div>
  </div>
  <a class="hero-scroll" href="#splash-lower" data-hero-scroll>
    <span class="hero-scroll__label">Scroll down</span>
    <span class="k-icon k-icon--arrow-down" aria-hidden="true"></span>
  </a>
  <button type="button" class="k-visually-hidden" data-hero-skip>
    Skip animation
  </button>
</div>}

<noscript>
  <style>
    .hero[data-hero-state='playing'] .hero-intro__logo {
      top: 0 !important;
    }

    .hero[data-hero-state='playing'] .hero-intro__rest {
      transform: none !important;
    }

    .hero[data-hero-state='playing'] .tagline {
      opacity: 1 !important;
    }
  </style>
</noscript>

<script is:inline>
  (() => {
    const hero = document.querySelector('[data-hero]');
    if (!(hero instanceof HTMLElement)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      hero.dataset.heroState = 'done';
    }
  })();
</script>

<script>
  import { playHeroIntro } from '../lib/heroIntro.ts';
  playHeroIntro();

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && hero.dataset.heroScrollCue !== 'true') {
    hero.dataset.heroScrollCue = 'true';
    const dismiss = (): void => {
      if (window.scrollY <= 0) return;
      hero.dataset.heroScrolled = 'true';
      window.removeEventListener('scroll', dismiss);
    };
    if (window.scrollY > 0) hero.dataset.heroScrolled = 'true';
    else window.addEventListener('scroll', dismiss, { passive: true });
  }
</script>

<style>
  @layer starlight.core {
    .hero {
      --stagger: 110ms;
      --fall: 900ms;
      --hold: 140ms;
      --k: 260ms;
      --jump: 160ms;
      --settle: 460ms;
      --letters: 7;
      --fall-end: calc((var(--letters) - 1) * var(--stagger) + var(--fall));
      --k-start: calc(var(--fall-end) + var(--hold));
      --shot: 40ms;

      position: relative;
      isolation: isolate;
      display: flex;
      min-height: 100dvh;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      padding-block: 2rem 3rem;
    }

    .hero::before {
      content: '';
      position: absolute;
      z-index: -1;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 100vw;
      translate: -50% 0;
      pointer-events: none;
      background:
        radial-gradient(
          70% 80% at 12% 8%,
          color-mix(in srgb, var(--k-primary) 32%, transparent),
          transparent 72%
        ),
        radial-gradient(
          55% 60% at 88% 0%,
          color-mix(in srgb, var(--k-surface-hard) 70%, transparent),
          transparent 68%
        ),
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--k-surface-hard) 42%, var(--k-surface)) 0%,
          var(--k-surface) 78%
        );
    }

    :global([data-theme='k-dark']) .hero::before {
      background:
        radial-gradient(
          140% 90% at 50% -20%,
          color-mix(in srgb, var(--k-primary) 46%, transparent),
          transparent 70%
        ),
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--k-primary) 16%, var(--k-surface)) 0%,
          var(--k-surface) 58%
        );
    }

    .hero-stage {
      position: relative;
      isolation: isolate;
      width: min(100%, calc(100vw - 3rem));
      overflow: visible;
    }

    .hero-panel {
      position: relative;
      z-index: 1;
      align-items: center;
      justify-content: center;
      overflow: visible;
    }

    .stack {
      flex: 1 1 auto;
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
      overflow: visible;
    }

    .copy {
      flex-direction: column;
      gap: 0.65rem;
      align-items: center;
      width: min(36rem, 100%);
      overflow: visible;
    }

    .hero-title {
      position: relative;
      width: 100%;
      height: 1.15em;
      font-size: clamp(2rem, calc((100vw - 5rem) / 21), var(--hero-title-size, 4.5rem));
      line-height: 1.15;
    }

    h1 {
      position: relative;
      margin: 0;
      width: 100%;
      height: 100%;
      font-size: inherit;
      line-height: inherit;
      font-weight: 600;
      color: var(--sl-color-white);
      text-align: center;
    }

    .hero-intro {
      position: absolute;
      top: 50%;
      left: 50%;
      display: inline-flex;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: center;
      column-gap: 0;
      white-space: nowrap;
      translate: -50% -50%;
    }

    @media (min-width: 1440px) {
      .hero-title {
        font-size: clamp(
          2rem,
          calc((100vw - 5rem) / 20.5),
          var(--hero-title-size, 4.5rem)
        );
      }
    }

    .hero[data-hero-state='playing']:not([data-hero-chars]) .hero-intro__logo {
      top: -100vh;
    }

    .hero[data-hero-state='playing']:not([data-hero-chars]) .hero-intro__rest {
      transform: translateY(-100vh);
    }

    .hero[data-hero-chars] :global(.hero-intro__char) {
      animation: hero-drop var(--fall) linear calc(var(--i) * var(--stagger)) both;
    }

    .hero[data-hero-launch] :global(.hero-intro__char) {
      --launch: calc(var(--n) * var(--shot));
      animation:
        hero-jump var(--jump) linear var(--launch) forwards,
        hero-settle var(--settle) linear calc(var(--launch) + var(--jump)) forwards;
    }

    .hero[data-hero-chars] .hero-intro__logo {
      animation: hero-drop-logo var(--k) linear var(--k-start) both;
    }

    .hero[data-hero-chars] .hero-intro__rest {
      position: relative;
      display: inline-block;
    }

    :global(.hero-intro__char) {
      position: absolute;
      top: 0;
      display: inline-block;
    }

    .hero-intro__logo-slot {
      position: relative;
      display: block;
      width: 1em;
      height: 1em;
      flex: none;
    }

    .hero-intro__logo {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      border-radius: 0.15em;
    }

    .tagline {
      flex-shrink: 0;
      max-width: 36rem;
      font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
      color: var(--sl-color-gray-2);
      text-align: center;
    }

    .hero[data-hero-state='playing'] .tagline,
    .hero[data-hero-state='settling'] .tagline {
      opacity: 0;
    }

    .hero[data-hero-state='done']:not([data-hero-skipped]) .tagline {
      animation: hero-tagline-in 0.6s ease both;
    }

    .tagline :global(p) {
      margin: 0;
    }

    .hero[data-hero-state='playing'],
    .hero[data-hero-state='settling'] {
      cursor: pointer;
    }

    .hero[data-hero-state='playing'] .actions,
    .hero[data-hero-state='settling'] .actions {
      cursor: auto;
    }

    .hero-scroll {
      position: absolute;
      bottom: 1.25rem;
      left: 50%;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      translate: -50% 0;
      color: var(--sl-color-gray-2);
      font-size: 0.9375rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      line-height: 1.2;
      text-decoration: none;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .hero-scroll .k-icon {
      width: 3.5rem;
      height: 3.5rem;
    }

    .hero-scroll:hover,
    .hero-scroll:focus-visible {
      color: var(--sl-color-white);
    }

    .hero[data-hero-state='done'] .hero-scroll {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: opacity 0.45s ease;
    }

    .hero[data-hero-state='done']:not([data-hero-skipped]) .hero-scroll {
      animation: hero-scroll-in 0.9s ease both;
    }

    .hero[data-hero-state='done'] .hero-scroll .k-icon {
      animation: hero-scroll-bounce 1.8s ease-in-out infinite;
    }

    .hero[data-hero-scrolled][data-hero-state='done'] .hero-scroll {
      animation: none;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity 0.45s ease,
        visibility 0s linear 0.45s;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero[data-hero-state='done'] .hero-scroll,
      .hero[data-hero-state='done'] .hero-scroll .k-icon,
      .hero[data-hero-state='done'] .tagline {
        animation: none;
      }

      .hero[data-hero-state='done'] .hero-scroll {
        transition: none;
      }

      .hero .tagline {
        opacity: 1;
      }
    }
  }

  @keyframes hero-tagline-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes hero-drop-logo {
    0% {
      top: -100vh;
      animation-timing-function: cubic-bezier(0.35, 0, 1, 1);
    }

    76% {
      top: 0.08em;
      animation-timing-function: cubic-bezier(0.2, 0, 0.35, 1);
    }

    88% {
      top: -0.16em;
      animation-timing-function: cubic-bezier(0.45, 0, 1, 1);
    }

    100% {
      top: 0;
    }
  }

  @keyframes hero-drop {
    0% {
      transform: translateY(-100vh);
      animation-timing-function: cubic-bezier(0.35, 0, 1, 1);
    }

    76% {
      transform: translateY(0.08em);
      animation-timing-function: cubic-bezier(0.2, 0, 0.35, 1);
    }

    88% {
      transform: translateY(-0.16em);
      animation-timing-function: cubic-bezier(0.45, 0, 1, 1);
    }

    100% {
      transform: none;
    }
  }

  @keyframes hero-jump {
    from {
      transform: none;
      animation-timing-function: cubic-bezier(0.05, 0.7, 0.2, 1);
    }

    to {
      transform: translateY(-1.35em);
    }
  }

  @keyframes hero-settle {
    0% {
      transform: translateY(-1.35em);
      animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
    }

    70% {
      transform: translateY(0.06em);
      animation-timing-function: cubic-bezier(0.2, 0, 0.4, 1);
    }

    100% {
      transform: none;
    }
  }

  @keyframes hero-scroll-in {
    from {
      opacity: 0;
      translate: -50% 0.5rem;
    }

    to {
      opacity: 1;
      translate: -50% 0;
    }
  }

  @keyframes hero-scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(0.3rem);
    }
  }
</style>
