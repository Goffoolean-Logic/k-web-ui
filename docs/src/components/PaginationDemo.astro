---
interface Props {
  id?: string;
  count?: number;
}

const { id = 'docs-pagination', count = 12 } = Astro.props;
const pages = Array.from({ length: count }, (_, index) => index);
---

{
  pages.map((index) => (
    <div id={`${id}-${index}`}>
      Page {index + 1} of {count}
    </div>
  ))
}
<k-pagination id={id} class="k-pagination"></k-pagination>

<script>
  import 'k-web-ui/js';
</script>
