---
interface Props {
  id?: string;
  count?: number;
  page?: number;
}

const { id = 'docs-pagination', count = 12, page = 5 } = Astro.props;
---

<div id={id} class="k-pagination" data-count={count} data-page={page}></div>

<script>
  import { KPagination } from 'k-web-components/js';

  document.querySelectorAll<HTMLElement>('.k-pagination[data-count]').forEach((root) => {
    const count = Number(root.dataset.count);
    const page = Number(root.dataset.page);
    KPagination.mount(root, { count, page });
  });
</script>
