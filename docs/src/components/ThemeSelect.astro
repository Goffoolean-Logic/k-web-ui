---
/**
 * Kit theme picker. Starlight still mounts this in the header on docs
 * pages. The splash hero mounts it next to the hero actions.
 */
import { DOCS_THEMES } from '../lib/themes';

const options = JSON.stringify(
  DOCS_THEMES.map((theme) => ({ label: theme.label })),
);
const id = `docs-theme-${crypto.randomUUID()}`;
const initial = DOCS_THEMES[0]?.label ?? 'K-light';
---

<starlight-theme-select>
  <k-dropdown
    id={id}
    class="k-dropdown"
    align="end"
    label={initial}
    options={options}></k-dropdown>
</starlight-theme-select>

{/* Inlined to avoid FOUC. Uses global scope from `ThemeProvider.astro` */}
<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  import 'k-web-ui/js';
  import { createIcon, type KIconName } from 'k-web-ui/js';
  import {
    parseDocsTheme,
    themeIcon,
    type DocsThemeId,
  } from '../lib/themes';

  const storageKey = 'starlight-theme';

  const loadTheme = (): DocsThemeId =>
    parseDocsTheme(
      typeof localStorage !== 'undefined' && localStorage.getItem(storageKey),
    );

  function storeTheme(theme: DocsThemeId): void {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme);
    }
  }

  function setIcon(el: Element, name: KIconName): void {
    el.className = `k-icon k-icon--${name}`;
    el.setAttribute('aria-hidden', 'true');
    el.setAttribute('data-theme-icon', '');
  }

  function decoratePicker(dropdown: Element, theme: DocsThemeId): void {
    const trigger = dropdown.querySelector('.k-dropdown__trigger');
    if (!(trigger instanceof HTMLElement)) return;

    const triggerName = themeIcon(theme);
    let triggerIcon = trigger.querySelector('[data-theme-icon]');
    if (triggerName) {
      if (!triggerIcon) {
        triggerIcon = createIcon(triggerName);
        triggerIcon.setAttribute('data-theme-icon', '');
        trigger.prepend(triggerIcon);
      } else {
        setIcon(triggerIcon, triggerName);
      }
    }

    for (const item of dropdown.querySelectorAll('.k-dropdown__item')) {
      const itemId = item.textContent?.trim() ?? '';
      const itemName = themeIcon(itemId);
      if (!itemName) continue;
      let icon = item.querySelector('[data-theme-icon]');
      if (!icon) {
        icon = createIcon(itemName);
        icon.setAttribute('data-theme-icon', '');
        item.prepend(icon);
      } else {
        setIcon(icon, itemName);
      }
    }
  }

  function decorateAll(theme: DocsThemeId): void {
    document
      .querySelectorAll('starlight-theme-select k-dropdown')
      .forEach((el) => decoratePicker(el, theme));
  }

  function onThemeChange(theme: DocsThemeId): void {
    window.StarlightThemeProvider.updatePickers(theme);
    document.documentElement.dataset.theme = theme;
    storeTheme(theme);
    decorateAll(theme);
  }

  class StarlightThemeSelect extends HTMLElement {
    constructor() {
      super();
      onThemeChange(loadTheme());
      this.addEventListener('k-change', (event) => {
        if (!(event instanceof CustomEvent)) {
          return;
        }
        onThemeChange(parseDocsTheme(event.detail?.label));
      });
    }

    connectedCallback(): void {
      const dropdown = this.querySelector('k-dropdown');
      if (!dropdown) return;

      const decorate = (): void => decoratePicker(dropdown, loadTheme());
      decorate();
      if (dropdown.querySelector('.k-dropdown__trigger')) return;

      const observer = new MutationObserver(() => {
        if (dropdown.querySelector('.k-dropdown__trigger')) {
          decorate();
          observer.disconnect();
        }
      });
      observer.observe(dropdown, { childList: true });
    }
  }
  if (!customElements.get('starlight-theme-select')) {
    customElements.define('starlight-theme-select', StarlightThemeSelect);
  }
</script>
