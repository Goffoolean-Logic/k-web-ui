---
/**
 * Kit theme picker. Starlight still mounts this in the header on docs
 * pages. The splash hero mounts it next to the hero actions.
 *
 * A static trigger is rendered in the HTML so the control is visible
 * before k-dropdown JS upgrades it. Labels follow data-theme from
 * ThemeProvider (inline in <head>).
 */
import { DOCS_THEMES } from '../lib/themes';

const items = DOCS_THEMES.map((theme) => ({ label: theme.label }));
const id = `docs-theme-${crypto.randomUUID()}`;
const light = DOCS_THEMES.find((theme) => theme.id === 'k-light');
const dark = DOCS_THEMES.find((theme) => theme.id === 'k-dark');
const initial = light?.label ?? 'K-light';
---

<starlight-theme-select>
  <k-dropdown id={id} class="k-dropdown k-dropdown--end">
    <button
      type="button"
      class="k-btn k-btn--secondary k-dropdown__trigger"
      aria-haspopup="menu"
      aria-expanded="false"
      tabindex="-1"
      inert
    >
      <span
        class={`k-icon k-icon--${light?.icon ?? 'sun'} k-icon--xs docs-theme-ssr docs-theme-ssr--light`}
        aria-hidden="true"
      ></span>
      <span
        class={`k-icon k-icon--${dark?.icon ?? 'moon'} k-icon--xs docs-theme-ssr docs-theme-ssr--dark`}
        aria-hidden="true"
      ></span>
      <span class="k-dropdown__label docs-theme-ssr docs-theme-ssr--light"
        >{light?.label ?? 'K-light'}</span
      >
      <span class="k-dropdown__label docs-theme-ssr docs-theme-ssr--dark"
        >{dark?.label ?? 'K-dark'}</span
      >
      <span class="k-icon k-icon--chevron-down k-icon--xs" aria-hidden="true"
      ></span>
    </button>
  </k-dropdown>
</starlight-theme-select>

{/* Runs after ThemeProvider; upgrades as soon as the element is defined. */}
<script is:inline define:vars={{ id, items, initial }}>
  customElements.whenDefined('k-dropdown').then(() => {
    const el = document.getElementById(id);
    if (!el) return;
    el.options = { trigger: initial, items };
    StarlightThemeProvider.updatePickers();
  });
</script>

<script>
  import 'k-web-ui/js';
  import { createIcon, type KIconName } from 'k-web-ui/js';
  import {
    parseDocsTheme,
    themeIcon,
    type DocsThemeId,
  } from '../lib/themes';

  const storageKey = 'starlight-theme';

  const loadTheme = (): DocsThemeId =>
    parseDocsTheme(
      typeof localStorage !== 'undefined' && localStorage.getItem(storageKey),
    );

  function storeTheme(theme: DocsThemeId): void {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme);
    }
  }

  function setIcon(el: Element, name: KIconName): void {
    el.className = `k-icon k-icon--${name}`;
    el.setAttribute('aria-hidden', 'true');
    el.setAttribute('data-theme-icon', '');
  }

  function decoratePicker(dropdown: Element, theme: DocsThemeId): void {
    const trigger = dropdown.querySelector('.k-dropdown__trigger');
    if (!(trigger instanceof HTMLElement)) return;

    const triggerName = themeIcon(theme);
    let triggerIcon = trigger.querySelector('[data-theme-icon]');
    if (triggerName) {
      if (!triggerIcon) {
        triggerIcon = createIcon(triggerName);
        triggerIcon.setAttribute('data-theme-icon', '');
        trigger.prepend(triggerIcon);
      } else {
        setIcon(triggerIcon, triggerName);
      }
    }

    for (const item of dropdown.querySelectorAll('.k-dropdown__item')) {
      const itemId = item.textContent?.trim() ?? '';
      const itemName = themeIcon(itemId);
      if (!itemName) continue;
      let icon = item.querySelector('[data-theme-icon]');
      if (!icon) {
        icon = createIcon(itemName);
        icon.setAttribute('data-theme-icon', '');
        item.prepend(icon);
      } else {
        setIcon(icon, itemName);
      }
    }
  }

  function decorateAll(theme: DocsThemeId): void {
    document
      .querySelectorAll('starlight-theme-select k-dropdown')
      .forEach((el) => decoratePicker(el, theme));
  }

  function onThemeChange(theme: DocsThemeId): void {
    window.StarlightThemeProvider.updatePickers(theme);
    document.documentElement.dataset.theme = theme;
    storeTheme(theme);
    decorateAll(theme);
  }

  class StarlightThemeSelect extends HTMLElement {
    constructor() {
      super();
      onThemeChange(loadTheme());
      this.addEventListener('k-change', (event) => {
        if (!(event instanceof CustomEvent)) {
          return;
        }
        onThemeChange(parseDocsTheme(event.detail?.label));
      });
    }

    connectedCallback(): void {
      const dropdown = this.querySelector('k-dropdown');
      if (!dropdown) return;

      const decorate = (): void => decoratePicker(dropdown, loadTheme());
      decorate();
      if (dropdown.querySelector('.k-dropdown__trigger:not([inert])')) return;

      const observer = new MutationObserver(() => {
        if (dropdown.querySelector('.k-dropdown__trigger:not([inert])')) {
          decorate();
          observer.disconnect();
        }
      });
      observer.observe(dropdown, { childList: true });
    }
  }
  if (!customElements.get('starlight-theme-select')) {
    customElements.define('starlight-theme-select', StarlightThemeSelect);
  }
</script>
