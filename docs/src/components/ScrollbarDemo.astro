---
interface Props {
  id?: string;
  autohide?: boolean;
  size?: 'sm' | 'lg';
  axis?: 'x' | 'y';
}

const {
  id = 'docs-scrollbar',
  autohide = true,
  size,
  axis = 'y',
} = Astro.props;

const lines = [
  'Overview',
  'Install the kit',
  'Put a class on a button',
  'Import the JS once',
  'Tabs label their own panels',
  'Pagination counts the pages it finds',
  'Dropdown builds the menu',
  'Carousel drives the track next door',
  'Gauge paints a square reading',
  'This pane is taller than its host',
  'Wheel, drag the thumb, or click the track',
  'Native bars stay hidden',
];
---

<k-scrollbar
  id={id}
  class:list={[
    'k-scrollbar',
    `k-scrollbar--${axis}`,
    size && `k-scrollbar--${size}`,
    !autohide && 'k-scrollbar--no-autohide',
  ]}
  style={axis === 'x' ? 'height: 4.5rem' : 'height: 12rem'}
>
  <ul>
    {lines.map((line) => <li>{line}</li>)}
  </ul>
</k-scrollbar>

<script>
  import 'k-web-ui/js';
</script>
