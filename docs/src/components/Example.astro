---
import { Code } from '@astrojs/starlight/components';

interface Props {
  html: string;
  stack?: boolean;
  lift?: boolean;
}

const { html, stack = false, lift = false } = Astro.props;
---

<div class="k-example not-content">
  <div
    class:list={[
      'k-preview',
      stack && 'k-preview--stack',
      lift && 'k-preview--lift',
    ]}
  >
    <slot />
  </div>
  <div class="k-example__source">
    <Code code={html} lang="html" />
  </div>
</div>
