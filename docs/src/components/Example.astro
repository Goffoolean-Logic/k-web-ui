---
import { Code } from '@astrojs/starlight/components';
import { toAngularExample, toReactExample } from '../lib/frameworkExamples';

interface Props {
  html: string;
  ts?: string;
  stack?: boolean;
  lift?: boolean;
}

const { html, ts, stack = false, lift = false } = Astro.props;

type Snippet = {
  label: string;
  lang: 'html' | 'ts' | 'tsx';
  code: string;
};

const snippets: Snippet[] = [{ label: 'HTML', lang: 'html', code: html }];
if (ts?.trim()) {
  snippets.push(
    { label: 'TS', lang: 'ts', code: ts },
    { label: 'Angular', lang: 'ts', code: toAngularExample(html, ts) },
    { label: 'React', lang: 'tsx', code: toReactExample(html, ts) },
  );
}

const tabbed = snippets.length > 1;
const sourceId = tabbed ? `docs-example-${crypto.randomUUID()}` : '';
const labels = snippets.map((snippet) => ({ label: snippet.label }));
---

<div class="k-example not-content">
  <div
    class:list={[
      'k-preview',
      stack && 'k-preview--stack',
      lift && 'k-preview--lift',
    ]}
  >
    <slot />
  </div>
  {
    tabbed ? (
      <div class="k-example__source k-example__source--tabs">
        <k-tabs
          id={sourceId}
          class="k-tabs k-example__code-tabs"
          aria-label="Example code"
        />
        {snippets.map((snippet, index) => (
          <div id={`${sourceId}-${index}`}>
            <Code code={snippet.code} lang={snippet.lang} />
          </div>
        ))}
      </div>
    ) : (
      <div class="k-example__source">
        <Code code={html} lang="html" />
      </div>
    )
  }
</div>

<script>
  import 'k-web-ui/js';
</script>

{
  tabbed && (
    <script is:inline define:vars={{ sourceId, labels }}>
      customElements.whenDefined('k-tabs').then(() => {
        document.getElementById(sourceId).options = labels;
      });
    </script>
  )
}
