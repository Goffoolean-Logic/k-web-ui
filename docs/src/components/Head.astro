---
import Default from '@astrojs/starlight/components/Head.astro';
import outfit from 'k-web-ui/source/base/fonts/outfit-latin.woff2?url';
import logo from '../assets/logo.png';
---

<link
  rel="preload"
  href={outfit}
  as="font"
  type="font/woff2"
  crossorigin
  fetchpriority="high"
/>
<link rel="preload" href={logo.src} as="image" fetchpriority="high" />
<Default><slot /></Default>
