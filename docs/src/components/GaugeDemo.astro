---
interface Props {
  id?: string;
  extras?: string;
  value?: string;
  max?: string;
  label?: string;
  text?: string;
}

const {
  id,
  extras = '',
  value,
  max = '100',
  label,
  text,
} = Astro.props;
---

<k-gauge
  id={id}
  class:list={['k-gauge', extras]}
  value={value}
  max={max}
  label={label}
  text={text}></k-gauge>

<script>
  import 'k-web-ui/js';
</script>
