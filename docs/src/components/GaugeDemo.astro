---
interface Props {
  id: string;
  class?: string;
  variant?: 'info' | 'success' | 'warning' | 'danger';
  size?: 'sm' | 'lg';
  indeterminate?: boolean;
  value?: number;
  max?: number;
  label?: string;
  format?: string;
  text?: string;
}

const {
  id,
  class: className,
  variant,
  size,
  indeterminate = false,
  value,
  max = 100,
  label,
  format,
  text,
} = Astro.props;

const options = {
  ...(value === undefined ? {} : { value }),
  max,
  ...(label ? { label } : {}),
  ...(format ? { format } : {}),
  ...(text ? { text } : {}),
  ...(variant ? { variant } : {}),
  ...(size ? { size } : {}),
  ...(indeterminate ? { indeterminate: true } : {}),
};
---

<k-gauge id={id} class:list={['k-gauge', className]}></k-gauge>

<script>
  import 'k-web-ui/js';
</script>

<script is:inline define:vars={{ id, options }}>
  customElements.whenDefined('k-gauge').then(() => {
    document.getElementById(id).options = options;
  });
</script>
