---
export type ClassKind = 'component' | 'part' | 'variant' | 'style' | 'modifier';

interface Row {
  name: string;
  type: ClassKind;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<div class="not-content k-class-table">
  <table class="k-table">
    <thead>
      <tr>
        <th>Class</th>
        <th>Type</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td>
              <code>{row.name}</code>
            </td>
            <td>{row.type}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
